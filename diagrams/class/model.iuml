' ============================================================
' Spotter — shared class model (included by every view)
' ============================================================
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  ArrowColor #444444
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #999999
}
skinparam stereotypeCBackgroundColor #E8EEF7
hide empty members

' ---------------- Presentation ----------------
package "presentation" $pres {
  class DashboardGUI $pres {
    - controller : CoachController
    - panels : List<BasePanel>
    + show() : void
  }
  abstract class BasePanel $pres {
    # controller : CoachController
    + {abstract} refresh() : void
    + onEvent(e : DomainEvent) : void
  }
  class ProfilePanel $pres {
    + onSaveClicked() : void
  }
  class LogPanel $pres {
    + onImportHevyClicked() : void
    + onImportWhoopClicked() : void
    + onManualEntrySubmitted() : void
  }
  class AnalyticsPanel $pres {
    + onLiftSelected(lift : Lift) : void
  }
  class PlanPanel $pres {
    + onGenerateClicked() : void
    + onSubstituteClicked(prescriptionId : int) : void
    + onAdjustClicked(sessionId : int) : void
    + onUndoClicked() : void
  }
  class MeetPanel $pres {
    + onCalculateClicked() : void
  }
  class NutritionPanel $pres {
    + onLogIntakeClicked() : void
    + onSuggestMealClicked() : void
  }
  class ChatPanel $pres {
    + onSendClicked() : void
  }
  class CoachCLI $pres {
    - controller : CoachController
    + run(argv : List<String>) : int
  }
}

' ---------------- Application ----------------
package "application" $app {
  class CoachController <<Facade>> $app {
    - profiles : ProfileRepository
    - workouts : WorkoutRepository
    - recovery : RecoveryRepository
    - blocks : BlockRepository
    - intake : IntakeRepository
    - importer : CsvImportService
    - analytics : StrengthAnalytics
    - attempts : AttemptCalculator
    - macros : MacroTracker
    - ruleEngine : RecoveryRuleEngine
    - agents : AgentRegistry
    - events : EventBus
    - editHistory : PlanEditHistory
    + saveProfile(p : LifterProfile) : void
    + importWorkouts(path : String) : ImportReport
    + importRecovery(path : String) : ImportReport
    + logWorkout(s : WorkoutSession) : void
    + getAnalytics(lift : Lift) : AnalyticsSummary
    + generateBlock(weeks : int) : AgentResult<TrainingBlock>
    + suggestSubstitute(prescriptionId : int) : AgentResult<ExercisePrescription>
    + flagSessions() : List<RecoveryFlag>
    + adjustSession(sessionId : int) : AgentResult<Session>
    + calculateAttempts() : List<MeetAttempts>
    + logIntake(e : FoodEntry) : MacroTotals
    + suggestMeal() : AgentResult<MealSuggestion>
    + chat(message : String) : AgentResult<String>
    + applyEdit(cmd : PlanEditCommand) : void
    + undoLastEdit() : void
  }
  class FxTaskRunner $app {
    + run(work : Supplier<T>, onDone : Consumer<T>, onError : Consumer<Throwable>) : void
  }
  note as N_FX
    Agent calls take seconds, so CoachController
    runs them through FxTaskRunner on a background
    thread. Results and events reach the panels on
    the JavaFX Application Thread via Platform.runLater,
    so the window never blocks.
  end note
  class EventBus <<Observer: Subject>> $app {
    - listeners : Map<EventType, List<EventListener>>
    + subscribe(t : EventType, l : EventListener) : void
    + unsubscribe(t : EventType, l : EventListener) : void
    + publish(e : DomainEvent) : void
  }
  interface EventListener <<Observer>> $app {
    + onEvent(e : DomainEvent) : void
  }
  class DomainEvent $app {
    + type : EventType
    + payload : object
    + timestamp : LocalDateTime
  }
  enum EventType $app {
    PROFILE_UPDATED
    DATA_IMPORTED
    PLAN_UPDATED
    RECOVERY_FLAGGED
    INTAKE_LOGGED
  }
  class PlanEditHistory <<Command: Invoker>> $app {
    - undoStack : List<PlanEditCommand>
    + execute(cmd : PlanEditCommand) : void
    + undo() : void
    + canUndo() : boolean
  }
  interface PlanEditCommand <<Command>> $app {
    + execute() : void
    + undo() : void
    + describe() : String
  }
  class SwapExerciseCommand $app {
    - block : TrainingBlock
    - prescriptionId : int
    - newExercise : Exercise
    - previous : Exercise
  }
  class ChangeLoadCommand $app {
    - block : TrainingBlock
    - prescriptionId : int
    - newLoadKg : double
    - previousLoadKg : double
  }
  class ApplyAdjustmentCommand $app {
    - block : TrainingBlock
    - adjusted : Session
    - original : Session
  }
  class AgentRegistry $app {
    + blockGen : BlockGenerationAgent
    + substitution : SubstitutionAgent
    + adjustment : AdjustmentAgent
    + attemptRationale : AttemptRationaleAgent
    + meal : MealSuggestionAgent
    + chat : ChatAgent
  }
}

' ---------------- Domain ----------------
package "domain" $dom {
  class LifterProfile $dom {
    + id : int
    + bodyweightKg : double
    + weightClassKg : double
    + goal : TrainingGoal
    + meetDate : LocalDate [0..1]
    + trainingDaysPerWeek : int
    + equipment : Set<Equipment>
    + hasMeetDate() : boolean
    + weeksUntilMeet(today : LocalDate) : Optional<Integer>
    + hasEquipment(e : Equipment) : boolean
  }
  class DietaryConstraints $dom {
    + vegetarian : boolean
    + allowsDairy : boolean
    + allowsEggs : boolean
    + permits(f : FoodItem) : boolean
  }
  enum TrainingGoal $dom {
    MEET_PREP
    STRENGTH
    HYPERTROPHY
    GENERAL_FITNESS
  }
  enum Lift $dom {
    SQUAT
    BENCH
    DEADLIFT
  }
  enum Equipment $dom {
    BARBELL
    DUMBBELL
    CABLE
    SMITH
    BELT_SQUAT
    DIP_BAR
    LEG_EXTENSION
    ...
  }
  class Exercise $dom {
    + id : int
    + name : String
    + muscleGroups : Set<String>
    + movementPattern : String
    + requiredEquipment : Set<Equipment>
    + competitionLift : Lift [0..1]
  }
  class WorkoutSession $dom {
    + id : int
    + date : LocalDate
    + source : String
    + totalTonnage() : double
  }
  class SetEntry $dom {
    + weightKg : double
    + reps : int
    + rpe : double [0..1]
  }
  class RecoveryDay $dom {
    + date : LocalDate
    + recoveryScore : int [0..1]
    + hrvMs : double [0..1]
    + sleepHours : double [0..1]
  }
  class TrainingBlock $dom {
    + id : int
    + startDate : LocalDate
    + progression : String
    + findSession(id : int) : Session
    + findPrescription(id : int) : ExercisePrescription
  }
  class Week $dom {
    + number : int
  }
  class Session $dom {
    + id : int
    + date : LocalDate
    + adjustmentNote : String [0..1]
  }
  class ExercisePrescription $dom {
    + id : int
    + sets : int
    + reps : int
    + targetRpe : double
    + loadKg : double
  }
  class MeetAttempts $dom {
    + lift : Lift
    + opener : double
    + second : double
    + third : double
    + rationale : String
  }
  class MacroTarget $dom {
    + calories : int
    + proteinG : double
    + carbsG : double
    + fatG : double
  }
  class DailyIntake $dom {
    + date : LocalDate
    + totals() : MacroTotals
  }
  class FoodEntry $dom {
    + grams : double
    + totals() : MacroTotals
  }
  class FoodItem $dom {
    + name : String
    + per100g : MacroTotals
    + vegetarian : boolean
    + containsDairy : boolean
    + containsEgg : boolean
  }
  class MacroTotals $dom {
    + calories : double
    + proteinG : double
    + carbsG : double
    + fatG : double
    + minus(o : MacroTotals) : MacroTotals
  }
  class AnalyticsSummary $dom {
    + lift : Lift
    + e1rmSeries : List<Point>
    + tonnage : List<Point>
    + bestSet : SetEntry [0..1]
    + warnings : List<String>
    + {static} empty(lift : Lift) : AnalyticsSummary
  }
  class Point $dom {
    + date : LocalDate
    + value : double
  }
  class Range $dom {
    + minKg : double
    + maxKg : double
    + contains(kg : double) : boolean
  }
  class MealSuggestion $dom {
    + rationale : String
    + totals() : MacroTotals
  }

  ' domain services
  class StrengthAnalytics $dom {
    - rpeChart : RPEChart
    + computeE1RM(s : SetEntry) : double
    + e1rmSeries(lift : Lift, h : List<WorkoutSession>) : List<Point>
    + weeklyTonnage(lift : Lift, h : List<WorkoutSession>) : List<Point>
    + bestSet(lift : Lift, h : List<WorkoutSession>) : SetEntry
    + currentE1RMs(h : List<WorkoutSession>) : Map<Lift, double>
  }
  class RPEChart $dom {
    + percentOf1RM(reps : int, rpe : double) : double
  }
  class AttemptCalculator $dom {
    - openerPct : double = 0.91
    - secondPct : double = 0.96
    - thirdPct : double = 1.01
    + calculateMeetAttempts(lift : Lift, e1rm : double) : MeetAttempts
    + projectTestDay(lift : Lift, e1rm : double) : TestDayPlan
    - roundToPlate(kg : double) : double
  }
  class TestDayPlan $dom {
    + lift : Lift
    + topSingle : double
    + warmups : List<Double>
    + rationale : String
  }
  class MacroTracker $dom {
    - target : MacroTarget
    + recordIntake(date : LocalDate, e : FoodEntry) : MacroTotals
    + getRemaining(date : LocalDate) : MacroTotals
    + weeklyAdherence(weekStart : LocalDate) : double
  }
  class RecoveryRuleEngine $dom {
    - minRecoveryScore : int = 33
    - minSleepHours : double = 6.0
    + evaluate(d : RecoveryDay) : RecoveryFlag [0..1]
    + fallbackAdjustment(s : Session) : Session
  }
  class RecoveryFlag $dom {
    + date : LocalDate
    + reasons : List<String>
  }
  class ProgressionStrategyFactory <<Factory>> $dom {
    + forGoal(g : TrainingGoal) : ProgressionStrategy
  }
  interface ProgressionStrategy <<Strategy>> $dom {
    + loadRange(e1rm : double, reps : int, rpe : double, week : int) : Range
    + describe() : String
  }
  class RPEProgression $dom
  class LinearProgression $dom
  class PercentageProgression $dom
}

' ---------------- Agent ----------------
package "agent" $agent {
  note as N_LC4J
    ClaudeClient and ConversationHistory wrap
    LangChain4j types (AnthropicChatModel,
    ToolSpecification, MessageWindowChatMemory).
    The rest of the system depends only on the
    LLMClient and Tool interfaces, so the
    framework stays replaceable.
  end note
  abstract class CoachAgent <<Template Method>> $agent {
    # llm : LLMClient
    # tools : ToolManager
    # prompts : PromptBuilder
    # parser : ResponseParser
    # validator : PlanValidator
    # maxRetries : int = 1
    # maxToolRounds : int = 5
    + run(req : AgentRequest) : AgentResult {final}
    # {abstract} createToolset() : List<Tool>
    # {abstract} gatherContext(req : AgentRequest) : AgentContext
    # {abstract} buildPrompt(ctx : AgentContext) : List<Message>
    # {abstract} parse(raw : String) : object
    # {abstract} validate(result : object, ctx : AgentContext) : ValidationReport
    - toolLoop(msgs : List<Message>) : LLMResponse
  }
  class BlockGenerationAgent $agent {
    - strategy : ProgressionStrategy
  }
  class SubstitutionAgent $agent
  class AdjustmentAgent $agent
  class AttemptRationaleAgent $agent
  class MealSuggestionAgent $agent
  class ChatAgent $agent {
    - memory : MemoryManager
  }
  class AgentRequest $agent {
    + kind : String
    + params : Map<String, object>
  }
  class AgentContext $agent {
    + profile : LifterProfile
    + facts : Map<String, object>
  }
  class "AgentResult<T>" as AgentResult $agent {
    + success : boolean
    + value : T [0..1]
    + errors : List<String>
    + attempts : int
  }

  interface LLMClient <<Strategy>> $agent {
    + complete(msgs : List<Message>, tools : List<ToolSchema>, system : String) : LLMResponse
  }
  class ClaudeClient $agent {
    - chatModel : AnthropicChatModel
    - modelName : String
    - maxTokens : int
    - timeoutSeconds : int
    - toSpecifications(t : List<ToolSchema>) : List<ToolSpecification>
    - fromAiMessage(m : AiMessage) : LLMResponse
  }
  class ScriptedLLMClient $agent {
    - responses : List<LLMResponse>
  }
  class LLMResponse $agent {
    + content : String [0..1]
    + toolCalls : List<ToolCall>
    + finishReason : String
  }
  class Message $agent {
    + role : String
    + content : String
  }
  class PromptBuilder <<Builder>> $agent {
    + system(text : String) : PromptBuilder
    + context(key : String, value : object) : PromptBuilder
    + schema(s : Map<String, Object>) : PromptBuilder
    + memory(snips : List<String>) : PromptBuilder
    + user(text : String) : PromptBuilder
    + build() : List<Message>
  }
  class ResponseParser $agent {
    + parseJson(raw : String) : Map<String, Object>
    + toBlock(d : Map<String, Object>, catalog : ExerciseCatalog) : TrainingBlock
    + toSession(d : Map<String, Object>) : Session
    + toMeal(d : Map<String, Object>, foods : FoodCatalog) : MealSuggestion
  }
  class PlanValidator $agent {
    + validateBlock(b : TrainingBlock, ctx : AgentContext, s : ProgressionStrategy) : ValidationReport
    + validateSubstitution(e : Exercise, allowed : List<Exercise>) : ValidationReport
    + validateMeal(m : MealSuggestion, d : DietaryConstraints, remaining : MacroTotals) : ValidationReport
    + validateRationale(text : String, a : MeetAttempts) : ValidationReport
  }
  class ValidationReport $agent {
    + valid : boolean
    + errors : List<String>
  }

  class ToolManager $agent {
    - tools : Map<String, Tool>
    - callLog : List<ToolCall>
    + register(t : Tool) : void
    + schemas() : List<ToolSchema>
    + execute(call : ToolCall) : ToolResult
  }
  interface Tool $agent {
    + name() : String
    + schema() : ToolSchema
    + execute(args : Map<String, Object>) : ToolResult
  }
  class ToolSchema $agent {
    + name : String
    + description : String
    + inputSchema : Map<String, Object>
  }
  class ToolCall $agent {
    + id : String
    + toolName : String
    + arguments : Map<String, Object>
  }
  class ToolResult $agent {
    + ok : boolean
    + data : object
    + error : String [0..1]
  }
  class AnalyticsTool $agent
  class ExerciseDBTool $agent
  class FoodDBTool $agent
  class PlanLookupTool $agent
  class RecoveryLookupTool $agent

  class MemoryManager $agent {
    - history : ConversationHistory
    - store : MemoryRepository
    + remember(user : Message, reply : Message) : void
    + recall(query : String, k : int) : List<String>
    + summarizeOlderTurns() : void
  }
  class ConversationHistory $agent {
    - chatMemory : MessageWindowChatMemory
    - maxTurns : int = 20
    + append(m : Message) : void
    + recent(n : int) : List<Message>
  }
}

' ---------------- Infrastructure ----------------
package "infrastructure" $infra {
  interface DataSource <<Adapter: Target>> $infra {
    + read(path : String) : ImportBatch
  }
  class HevyCsvAdapter <<Adapter>> $infra
  class WhoopCsvAdapter <<Adapter>> $infra
  class CsvFileReader <<Adaptee>> $infra {
    + rows(path : String) : Iterator<Map<String, Object>>
    + header(path : String) : List<String>
  }
  class DataSourceFactory <<Factory>> $infra {
    + create(kind : SourceKind) : DataSource
    + detect(path : String) : SourceKind
  }
  enum SourceKind $infra {
    HEVY
    WHOOP
  }
  class ImportBatch $infra {
    + sessions : List<WorkoutSession>
    + recoveryDays : List<RecoveryDay>
    + rowErrors : List<String>
  }
  class ImportReport $infra {
    + imported : int
    + duplicatesSkipped : int
    + unknownExercises : List<String>
    + rowErrors : List<String>
  }
  class CsvImportService $infra {
    - factory : DataSourceFactory
    - catalog : ExerciseCatalog
    + importFile(path : String, kind : SourceKind) : ImportReport
    - mapExerciseNames(b : ImportBatch) : List<String>
    - dedupe(b : ImportBatch) : int
  }
  class ExerciseCatalog $infra {
    + byName(name : String) : Exercise [0..1]
    + closestMatches(name : String, k : int) : List<Exercise>
    + addAlias(alias : String, e : Exercise) : void
    + add(e : Exercise) : void
    + candidates(pattern : String, muscles : Set<String>, eq : Set<Equipment>) : List<Exercise>
  }
  class FoodCatalog $infra {
    + search(d : DietaryConstraints, maxCalories : double) : List<FoodItem>
    + byName(name : String) : FoodItem [0..1]
    + add(f : FoodItem) : void
  }
  interface "Repository<T>" as Repository $infra {
    + save(item : T) : T
    + findById(id : int) : T [0..1]
    + findAll() : List<T>
    + delete(id : int) : void
  }
  class Database $infra {
    - path : String
    + connection() : Connection
    + migrate() : void
  }
  class ProfileRepository $infra
  class WorkoutRepository $infra {
    + findByLift(l : Lift, since : LocalDate) : List<WorkoutSession>
  }
  class RecoveryRepository $infra {
    + findByDate(d : LocalDate) : RecoveryDay [0..1]
  }
  class BlockRepository $infra {
    + findActive() : TrainingBlock [0..1]
  }
  class IntakeRepository $infra
  class MemoryRepository $infra {
    + search(query : String, k : int) : List<String>
  }
}

' ============================================================
' Relationships
' ============================================================

' presentation
DashboardGUI "1" *-- "7" BasePanel
BasePanel <|-- ProfilePanel
BasePanel <|-- LogPanel
BasePanel <|-- AnalyticsPanel
BasePanel <|-- PlanPanel
BasePanel <|-- MeetPanel
BasePanel <|-- NutritionPanel
BasePanel <|-- ChatPanel
BasePanel ..|> EventListener
BasePanel "*" --> "1" CoachController
CoachCLI --> "1" CoachController

' application
CoachController *-- "1" EventBus
CoachController *-- "1" PlanEditHistory
CoachController *-- "1" AgentRegistry
CoachController --> "1" FxTaskRunner
CoachController --> ProgressionStrategyFactory
EventBus "1" o-- "*" EventListener : notifies >
EventBus ..> DomainEvent
DomainEvent --> EventType
PlanEditHistory "1" o-- "*" PlanEditCommand
PlanEditCommand <|.. SwapExerciseCommand
PlanEditCommand <|.. ChangeLoadCommand
PlanEditCommand <|.. ApplyAdjustmentCommand
SwapExerciseCommand --> TrainingBlock : receiver
ChangeLoadCommand --> TrainingBlock : receiver
ApplyAdjustmentCommand --> TrainingBlock : receiver
AgentRegistry o-- "6" CoachAgent
CoachController --> CsvImportService
CoachController --> StrengthAnalytics
CoachController --> AttemptCalculator
CoachController --> MacroTracker
CoachController --> RecoveryRuleEngine
CoachController --> Repository

' domain structure
LifterProfile "1" *-- "1" DietaryConstraints
LifterProfile "1" -- "0..*" WorkoutSession : logs >
LifterProfile "1" -- "0..*" RecoveryDay : tracks >
LifterProfile "1" -- "0..1" TrainingBlock : follows >
LifterProfile "1" -- "1" MacroTarget
WorkoutSession "1" *-- "1..*" SetEntry
SetEntry "*" --> "1" Exercise
TrainingBlock "1" *-- "1..*" Week
Week "1" *-- "1..*" Session
Session "1" *-- "1..*" ExercisePrescription
ExercisePrescription "*" --> "1" Exercise
DailyIntake "1" *-- "0..*" FoodEntry
FoodEntry "*" --> "1" FoodItem
MealSuggestion "1" *-- "1..*" FoodEntry
StrengthAnalytics *-- "1" RPEChart
StrengthAnalytics ..> AnalyticsSummary : creates
AnalyticsSummary "1" o-- "*" Point
ProgressionStrategy ..> Range
Tool ..> ToolSchema
MacroTracker --> "1" MacroTarget
MacroTracker ..> DailyIntake
AttemptCalculator ..> MeetAttempts : creates
AttemptCalculator ..> TestDayPlan : creates
ProgressionStrategyFactory ..> ProgressionStrategy : creates
LifterProfile --> TrainingGoal
RecoveryRuleEngine ..> RecoveryFlag : creates
ProgressionStrategy <|.. RPEProgression
ProgressionStrategy <|.. LinearProgression
ProgressionStrategy <|.. PercentageProgression

' agent
CoachAgent <|-- BlockGenerationAgent
CoachAgent <|-- SubstitutionAgent
CoachAgent <|-- AdjustmentAgent
CoachAgent <|-- AttemptRationaleAgent
CoachAgent <|-- MealSuggestionAgent
CoachAgent <|-- ChatAgent
CoachAgent "*" o-- "1" LLMClient
CoachAgent "1" *-- "1" ToolManager
CoachAgent --> PromptBuilder
CoachAgent --> ResponseParser
CoachAgent --> PlanValidator
CoachAgent ..> AgentRequest
CoachAgent ..> AgentContext
CoachAgent ..> AgentResult
BlockGenerationAgent --> "1" ProgressionStrategy
PlanValidator ..> ProgressionStrategy
PlanValidator ..> ValidationReport
ChatAgent --> "1" MemoryManager
LLMClient <|.. ClaudeClient
LLMClient <|.. ScriptedLLMClient
LLMClient ..> LLMResponse
LLMClient ..> Message
LLMResponse "1" *-- "0..*" ToolCall
ToolManager "1" o-- "*" Tool
ToolManager ..> ToolCall
ToolManager ..> ToolResult
Tool <|.. AnalyticsTool
Tool <|.. ExerciseDBTool
Tool <|.. FoodDBTool
Tool <|.. PlanLookupTool
Tool <|.. RecoveryLookupTool
AnalyticsTool --> StrengthAnalytics
AnalyticsTool --> WorkoutRepository
ExerciseDBTool --> ExerciseCatalog
FoodDBTool --> FoodCatalog
PlanLookupTool --> BlockRepository
RecoveryLookupTool --> RecoveryRepository
MemoryManager *-- "1" ConversationHistory
ConversationHistory "1" *-- "0..*" Message
MemoryManager --> MemoryRepository

' infrastructure
DataSource <|.. HevyCsvAdapter
DataSource <|.. WhoopCsvAdapter
HevyCsvAdapter --> CsvFileReader : adapts
WhoopCsvAdapter --> CsvFileReader : adapts
DataSourceFactory ..> DataSource : creates
DataSourceFactory --> SourceKind
CsvImportService --> DataSourceFactory
CsvImportService --> ExerciseCatalog
CsvImportService ..> ImportBatch
CsvImportService ..> ImportReport
Repository <|.. ProfileRepository
Repository <|.. WorkoutRepository
Repository <|.. RecoveryRepository
Repository <|.. BlockRepository
Repository <|.. IntakeRepository
Repository <|.. MemoryRepository
ProfileRepository --> Database
WorkoutRepository --> Database
RecoveryRepository --> Database
BlockRepository --> Database
IntakeRepository --> Database
MemoryRepository --> Database
