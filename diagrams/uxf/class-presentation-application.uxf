    <panel_attributes>&lt;&lt;Facade&gt;&gt;
CoachController
--
- profiles : ProfileRepository
- workouts : WorkoutRepository
- recovery : RecoveryRepository
- blocks : BlockRepository
- intake : IntakeRepository
- importer : CsvImportService
- analytics : StrengthAnalytics
- attempts : AttemptCalculator
- macros : MacroTracker
- ruleEngine : RecoveryRuleEngine
- agents : AgentRegistry
- events : EventBus
- editHistory : PlanEditHistory
--
+ saveProfile(p : LifterProfile) : void
+ importWorkouts(path : String) : ImportReport
+ importRecovery(path : String) : ImportReport
+ logWorkout(s : WorkoutSession) : void
+ logSessionAsPrescribed(sessionId : int, deviations : List&lt;SetEntry&gt;) : WorkoutSession
+ recordCheckIn(d : RecoveryDay) : RecoveryFlag [0..1]
+ importWithMapping(path : String, m : ColumnMapping) : ImportReport
+ saveImportProfile(m : ColumnMapping) : void
+ getAnalytics(lift : Lift) : AnalyticsSummary
+ generateBlock(weeks : int) : AgentResult&lt;TrainingBlock&gt;
+ suggestSubstitute(prescriptionId : int) : AgentResult&lt;ExercisePrescription&gt;
+ flagSessions() : List&lt;RecoveryFlag&gt;
+ adjustSession(sessionId : int) : AgentResult&lt;Session&gt;
+ calculateAttempts() : List&lt;MeetAttempts&gt;
+ logIntake(e : FoodEntry) : MacroTotals
+ suggestMeal() : AgentResult&lt;MealSuggestion&gt;
+ reviewAdherence(weekNumber : int) : AdherenceReport
+ progressPlan(weekNumber : int) : AgentResult&lt;TrainingBlock&gt;
+ chat(message : String) : AgentResult&lt;String&gt;
+ applyEdit(cmd : PlanEditCommand) : void
+ undoLastEdit() : void</panel_attributes>
