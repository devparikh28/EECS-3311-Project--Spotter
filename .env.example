# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own key.
#   cp .env.example .env
# .env is ignored by git and must never be committed.

# Anthropic API key, used by ClaudeClient.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Model used for ordinary agent calls.
#
# Deliberately a 4.x model. The LangChain4j
# version this project pins knows only text and
# tool_use content blocks, and the 5.x models
# return a thinking block it cannot read. Moving
# to a newer model means replacing ClaudeClient
# with direct Messages API calls, which nothing
# else in the project would notice.
LLM_MODEL=claude-haiku-4-5-20251001

# Model used where more reasoning is wanted,
# such as generating a whole training block.
LLM_MODEL_REASONING=claude-sonnet-4-6

# Upper bound on tokens per reply.
LLM_MAX_TOKENS=4096

# Seconds before a model call is abandoned.
LLM_TIMEOUT_SECONDS=60

# Published price of the models above, in US
# dollars per million tokens. Used only to report
# what a run cost; change these if the published
# rates change or you switch model.
LLM_INPUT_PER_MILLION=2.0
LLM_OUTPUT_PER_MILLION=10.0

# Where the local SQLite file is created.
SPOTTER_DB_PATH=spotter.db
