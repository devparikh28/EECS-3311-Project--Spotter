# .env.example - contains no real credentials.
# Copy this file to .env and fill in your own key.
#   cp .env.example .env
# .env is ignored by git and must never be committed.

# Anthropic API key, used by ClaudeClient.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Model used for ordinary agent calls.
LLM_MODEL=claude-3-5-haiku-20241022

# Model used where more reasoning is wanted,
# such as generating a whole training block.
LLM_MODEL_REASONING=claude-3-5-sonnet-20241022

# Upper bound on tokens per reply.
LLM_MAX_TOKENS=4096

# Seconds before a model call is abandoned.
LLM_TIMEOUT_SECONDS=60

# Where the local SQLite file is created.
SPOTTER_DB_PATH=spotter.db
