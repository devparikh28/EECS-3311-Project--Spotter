LifterProfile "1" -- "0..*" RecoveryDay : tracks >
LifterProfile "1" -- "0..1" TrainingBlock : follows >
LifterProfile "1" -- "1" MacroTarget
WorkoutSession "1" *-- "1..*" SetEntry
SetEntry "*" --> "1" Exercise
TrainingBlock "1" *-- "1..*" Week
Week "1" *-- "1..*" Session
Session "1" *-- "1..*" ExercisePrescription
ExercisePrescription "*" --> "1" Exercise
DailyIntake "1" *-- "0..*" FoodEntry
FoodEntry "*" --> "1" FoodItem
MealSuggestion "1" *-- "1..*" Portion
Portion "*" --> "1" FoodItem
StrengthAnalytics *-- "1" RPEChart
